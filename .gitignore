# Go
/server/server
/server/bin/
/server/md-builder
*.exe

# Local SQLite databases (created at runtime by the server or adduser).
*.db

# Server configuration holding object-storage credentials. Commit
# md-builder-server.example.yaml instead.
md-builder-server.yaml

# Optional Docker/Podman deployment settings. docker-compose.yml needs no
# file — it defaults everything but the MinIO password, which it takes from
# the environment — but compose reads a .env automatically if you make one,
# and that one holds a credential.
.env

# Docker/Podman deployment state: the SQLite database and the MinIO buckets
# bind-mounted by docker-compose.yml.
/data/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# OS / Editor
.DS_Store
*.swp
.idea/
.vscode/
private/
